//fxGetDuplicates
(myTable as table, optional fieldsToCheck as any, optional infoFields as any) =>
let
  /*
  myTable = #"Dealer Mapping Duplicate Check",
  fieldsToCheck = {"source_dealer_code","source_dealer_name"},
  infoFields = {"SourceFile"},
  */
  Fields = fieldsToCheck ?? Table.ColumnNames(myTable),
  Info = infoFields ?? {},

  checkField = (fieldName as text) =>
    let
      // Detect duplicates on the field alone, so rows with the same id in different files still count
      counts = Table.Group(myTable, {fieldName}, {{"Count", Table.RowCount, type number}}),
      dupValues = Table.Column(Table.SelectRows(counts, each [Count] > 1), fieldName),
      dupRows = Table.SelectRows(myTable, each List.Contains(dupValues, Record.Field(_, fieldName))),

      duplicateIds = List.Distinct(Table.Column(dupRows, fieldName)),
      base = [
        #"Field Name" = fieldName,
        #"Duplicate Ids" = Text.Combine(List.RemoveNulls(List.Transform(duplicateIds, Text.From)), ", ")
      ],

      // One text column per info field: distinct values from the duplicate rows
      infoValues = List.Transform(
        Info,
        each Text.Combine(
          List.RemoveNulls(List.Distinct(List.Transform(Table.Column(dupRows, _), Text.From))),
          ", "
        )
      ),
      infoRecord = Record.FromList(infoValues, Info)
    in
      Record.Combine({base, infoRecord}),

  getRecords = List.Transform(Fields, checkField),
  result = Table.FromRecords(getRecords),
  #"Filtered rows" = Table.SelectRows(result, each [Duplicate Ids] <> null and [Duplicate Ids] <> ""),
  #"Changed column type" = Table.TransformColumnTypes(
    #"Filtered rows",
    List.Transform(Table.ColumnNames(#"Filtered rows"), each {_, type text})
  )
in
  #"Changed column type"
