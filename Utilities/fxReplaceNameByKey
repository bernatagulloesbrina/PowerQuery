(factTable as table, lookupTable as table, factTableSearchField as text, lookupTableSearchField as text, lookupTableReturnField as text, optional leftJoin as logical) =>
let
  
  
  /*
  factTable = #"Warranty Reimbursements",
  lookupTable = mapping_dealer_by_dealer_code,
  factTableSearchField =  "Dealer Number",
  lookupTableSearchField = "source_dealer_code",
  lookupTableReturnField = "dealer_key",
  leftJoin = false,
  */
  nestedTableFieldName = "joinTableField",
  validatedLookupTable =
    if List.Contains(Table.ColumnNames(lookupTable), lookupTableReturnField)
    then lookupTable
    else error Error.Record(
      "Column not found",
      "fxReplaceNameByKey: the column '" & lookupTableSearchField & "' does not exist in lookupTable.",
      Table.ColumnNames(lookupTable)
    ),
  #"Merged queries" = Table.NestedJoin(factTable, {factTableSearchField}, validatedLookupTable, {lookupTableSearchField}, nestedTableFieldName, if leftJoin ?? false then JoinKind.LeftOuter else JoinKind.Inner),
  expandedTable = Table.ExpandTableColumn(#"Merged queries", nestedTableFieldName, {lookupTableReturnField}, {lookupTableReturnField}),
  #"Removed columns" = Table.RemoveColumns(expandedTable, {factTableSearchField})
in
  #"Removed columns"
